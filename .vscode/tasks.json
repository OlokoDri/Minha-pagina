{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar servidor local",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "5501"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen",
        "reevaluateOnRerun": true
      }
    }
  ]
}
